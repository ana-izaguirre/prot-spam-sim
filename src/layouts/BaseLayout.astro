---
import '../index.css';

interface Props {
  title: string;
  description: string;
  /** Overrides the <html lang> default; the boot script may still narrow it. */
  lang?: string;
}

const { title, description, lang = 'es' } = Astro.props;

// Absolute URLs are only emitted once a deployment origin is configured
// (`site` in astro.config.mjs). Without one, a canonical or og:url tag would
// point at localhost, which is worse than omitting it.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Ana Izaguirre Matamoros" />
    <meta
      name="keywords"
      content="Prot-SpaM, MPI, HPC, filogenia, spaced words, FinisTerrae III, CESGA, UDC"
    />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#020617" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ProtSpam HPC Suite" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />

    {/*
      Apply the stored theme and language before first paint, so a returning
      visitor never sees the default dark/Spanish shell flash before React
      reconciles. This must stay in sync with LanguageThemeProvider: same two
      keys, same class names, same fallbacks.
    */}
    <script is:inline>
      (function () {
        try {
          var theme = window.localStorage.getItem('protspam_theme');
          var root = document.documentElement;
          if (theme === 'light') {
            root.classList.add('light-theme');
            root.classList.remove('dark');
          }
          var lang = window.localStorage.getItem('protspam_lang');
          if (lang === 'en' || lang === 'es') root.lang = lang;
        } catch (e) {
          /* storage blocked: keep the server-rendered defaults */
        }
      })();
    </script>
  </head>
  <!-- Token utilities, not arbitrary hex values: the light theme remaps the
       slate ramp, and an arbitrary colour would not follow it. -->
  <body
    class="bg-slate-950 text-slate-100 antialiased selection:bg-sky-400/30 selection:text-sky-300"
  >
    <slot />
  </body>
</html>
