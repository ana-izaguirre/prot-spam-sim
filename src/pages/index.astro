---
import AppShell from '../islands/AppShell';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ProtSpam MPI HPC Suite & Simulator"
  description="Simulador de reparto de carga MPI, matrices triangulares y escalabilidad HPC para ProtSpam."
>
  <!-- The active module, language and theme are shared client state, so the whole
       suite hydrates as one island (specs/.../plan.md, decision D3). client:load
       rather than client:only, so the shell is prerendered into the HTML and the
       visitor sees the interface before React boots. -->
  <AppShell client:load />
</BaseLayout>
